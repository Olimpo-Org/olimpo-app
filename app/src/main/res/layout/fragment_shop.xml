<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/Pure_White"
    tools:context=".presentation.fragment.negotiationFlow.ShopFragment">


    <!-- TODO: Update blank fragment layout -->


        <LinearLayout
            android:id="@+id/footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/background_footer"
            android:orientation="horizontal"
            android:layout_marginTop="10dp"
            android:padding="20dp"
            app:layout_constraintBottom_toTopOf="@+id/conversationsRecyclerView"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="1.0">


            <Button
                android:id="@+id/btnVenda"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginLeft="@dimen/_10ssp"
                android:text="Venda"
                android:textColor="@color/Pure_White" />

            <Button
                android:id="@+id/btnServico"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginLeft="@dimen/_20ssp"
                android:text="Serviço"
                android:textColor="@color/Pure_White" />

            <Button
                android:id="@+id/btnDoacao"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginLeft="@dimen/_20ssp"
                android:text="Doação"
                android:textColor="@color/Pure_White" />


        </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/conversationsRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="660dp"
        android:clipToPadding="false"
        android:layout_marginTop="@dimen/_80sdp"
        android:orientation="vertical"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        android:visibility="gone"
        tools:listitem="@layout/item_shop" />
    <LinearLayout
        android:id="@+id/layoutError"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:visibility="visible"
        >

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/archive_not_found"

            />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/_50ssp"
            android:layout_marginTop="@dimen/_20sdp"
            android:layout_marginRight="@dimen/_50ssp"
            android:text="Essa comunidade não possui anúncios... Publique você!!"
            android:textAlignment="center"
            android:textColor="@color/Grey_Standard"
            android:textSize="@dimen/_15sdp" />
    </LinearLayout>
</FrameLayout>