<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/Pure_White"
    tools:context=".presentation.fragment.feedFlow.OtherUserProfileFragment">

    <!-- TODO: Update blank fragment layout -->

    <com.makeramen.roundedimageview.RoundedImageView
        android:id="@+id/OlimpoFoto"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginTop="@dimen/_20sdp"
        android:layout_marginLeft="@dimen/_130sdp"
        android:background="@drawable/userloading"
        android:scaleType="centerCrop"/>

    <TextView
        android:id="@+id/username"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="40dp"
        android:layout_marginTop="@dimen/_65sdp"
        android:text="Other_Username"
        android:gravity="center"
        android:textColor="@color/Black"
        android:textSize="@dimen/_14ssp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonSignIn"
        android:layout_width="200dp"
        android:layout_height="60dp"
        android:layout_marginLeft="@dimen/_105sdp"
        android:gravity="center"
        android:layout_marginTop="@dimen/_95sdp"
        android:backgroundTint="@color/Blue"
        android:text="Conversar no chat"
        android:textColor="@color/White"
        android:textSize="@dimen/_13ssp"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/conversationsRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="555dp"
        android:layout_marginTop="288dp"
        android:clipToPadding="false"
        android:orientation="vertical"
        tools:listitem="@layout/item_profile"
        android:visibility="gone"
        />

    <LinearLayout
        android:id="@+id/layoutError"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:visibility="visible"
        >

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/archive_not_found"

            />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/_50ssp"
            android:layout_marginTop="@dimen/_20sdp"
            android:layout_marginRight="@dimen/_50ssp"
            android:text="Esse usuário não tem publicações..."
            android:textAlignment="center"
            android:textColor="@color/Grey_Standard"
            android:textSize="@dimen/_15sdp" />
    </LinearLayout>
</FrameLayout>